# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Environment Variables for Sensitive Configuration
#
# This is an EXAMPLE file showing required environment variables.
# DO NOT commit actual credentials to version control.
#
# Usage:
#   1. Copy this file to .env in the project root
#   2. Fill in the actual values from your EMR system
#   3. Add .env to .gitignore (usually already done)
#   4. Load variables before running the simulator:
#      export $(cat .env | xargs)    # macOS/Linux
#      # or use python-dotenv package
#
# Security Levels:
#   🔴 RED       — Never commit these credentials
#   🟡 YELLOW    — Use caution; prefer env vars over defaults
#   🟢 GREEN     — Safe to reference; use as-is
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════════
# EMR API CONFIGURATION  [🟡 YELLOW - use with caution]
# ═══════════════════════════════════════════════════════════════════════════════

# EMR API endpoint (typically OpenEMR compatible REST API)
# Default: http://192.168.29.116:8081/apis/default
EMR_API_BASE_URL="http://192.168.29.116:8081/apis/default"

# ═══════════════════════════════════════════════════════════════════════════════
# OAUTH2 CREDENTIALS  [🔴 RED - NEVER commit real values]
# ═══════════════════════════════════════════════════════════════════════════════

# OAuth2 token endpoint for EMR authentication
# Example: http://192.168.29.116:8081/oauth2/default/token
EMR_OAUTH_TOKEN_URL="http://192.168.29.116:8081/oauth2/default/token"

# OAuth2 client credentials (for service-to-service authentication)
# NEVER commit these to version control
# Generate from your EMR system's OAuth admin interface
EMR_OAUTH_CLIENT_ID="YOUR_ACTUAL_CLIENT_ID_HERE"
EMR_OAUTH_CLIENT_SECRET="YOUR_ACTUAL_CLIENT_SECRET_HERE"

# Service account credentials (for password grant type)
# NEVER commit these to version control
EMR_OAUTH_USERNAME="admin"
EMR_OAUTH_PASSWORD="YOUR_ACTUAL_PASSWORD_HERE"

# OAuth scope (permissions)
# Typically: api:oemr user/Patient.read user/Patient.write ...
EMR_OAUTH_SCOPE="api:oemr user/Patient.read user/Patient.write user/patient.read user/patient.write user/Encounter.rs user/encounter.crus"

# ═══════════════════════════════════════════════════════════════════════════════
# TLS/mTLS CERTIFICATES  [🟡 YELLOW - sensitive paths]
# ═══════════════════════════════════════════════════════════════════════════════

# Path to certificate directory (for secure EMR connections)
# Can be relative (~/Downloads/certs) or absolute (/etc/ssl/certs)
EMR_CERT_DIR="~/Downloads/certs"

# Certificate files (relative to EMR_CERT_DIR)
EMR_CA_CERT="ca.crt"
EMR_CLIENT_CERT="client.crt"
EMR_CLIENT_KEY="client-pkcs8.key"
EMR_SERVER_CERT="server.crt"

# Optional: Server name override (if connecting to IP but cert has DNS SAN)
# Example: connecting to 192.168.1.1 but certificate has SAN="medical-server.local"
EMR_SERVER_NAME_OVERRIDE=""

# ═══════════════════════════════════════════════════════════════════════════════
# SIMULATOR BEHAVIOR  [🟢 GREEN - safe to reference]
# ═══════════════════════════════════════════════════════════════════════════════

# Polling interval (seconds between EMR status checks)
EMR_POLL_INTERVAL="5"

# Data transmission interval (seconds between telemetry sends to EMR)
EMR_SEND_INTERVAL="1"

# Enable/disable TLS certificate verification
EMR_VERIFY_TLS="true"

# Debug logging level: DEBUG, INFO, WARNING, ERROR
EMR_LOG_LEVEL="INFO"

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════════════════════
#
# For Docker deployment, pass variables using docker run -e:
#   docker run -e EMR_OAUTH_CLIENT_ID="..." -e EMR_OAUTH_CLIENT_SECRET="..." ...
#
# For Kubernetes, use Secrets:
#   kubectl create secret generic emr-secrets \
#     --from-literal=EMR_OAUTH_CLIENT_ID="..." \
#     --from-literal=EMR_OAUTH_CLIENT_SECRET="..."
#
# For GitHub Actions, use Repository Secrets:
#   Settings → Secrets and Variables → Actions → New repository secret
#
# ─────────────────────────────────────────────────────────────────────────────
